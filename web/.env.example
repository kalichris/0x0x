# MHDDoS Web Panel Configuration

# Host IP to bind the web panel (Default: 0.0.0.0 = accessible on the LAN)
WEB_HOST=0.0.0.0

# Port for the web panel (Default: 5000)
WEB_PORT=5000

# Secret key used by the server to sign and verify JWT authentication tokens
# Generate a random key with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me

